{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "sci-select model-neutral paper profile",
  "type": "object",
  "required": [
    "direction_summary",
    "primary_field",
    "specialty",
    "research_object",
    "research_question",
    "contribution_type",
    "target_audience",
    "methods",
    "exclusions",
    "search_queries"
  ],
  "properties": {
    "direction_summary": {"type": "string", "minLength": 3},
    "primary_field": {"type": "string"},
    "specialty": {"type": "string"},
    "research_object": {"type": "string"},
    "research_question": {"type": "string"},
    "contribution_type": {"type": "string"},
    "target_audience": {"type": "array", "items": {"type": "string"}},
    "methods": {"type": "array", "items": {"type": "string"}},
    "exclusions": {"type": "array", "items": {"type": "string"}},
    "search_queries": {
      "type": "array",
      "minItems": 2,
      "maxItems": 3,
      "items": {"type": "string", "minLength": 3}
    }
  },
  "additionalProperties": true
}
